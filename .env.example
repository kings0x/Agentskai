# Keep HOST loopback unless you intentionally want LAN access.
HOST=127.0.0.1
PORT=3000
AGENTDOCK_PASSWORD=change-me
# Optional: defaults to ./data relative to the runtime.
# AGENTDOCK_DATA_DIR=/path/to/agentdock-data
# Optional directory prefilled in the new-session and automation forms.
# AGENTDOCK_DEFAULT_CWD=/mnt/c/Users/you/Code
# AGENTDOCK_MAX_SESSIONS=20
